# Run from the project root:
#   cmake -P tools/generate-cmake-presets.cmake
# Optional arguments must appear before -P:
#   -DOUTPUT_DIR=<project-directory> -DPLATFORM=windows|linux -DOVERWRITE=ON
cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED PLATFORM)
  if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    set(PLATFORM "windows")
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    set(PLATFORM "linux")
  else()
    message(FATAL_ERROR "Supported platforms: Windows and Linux. Set -DPLATFORM=windows or -DPLATFORM=linux to generate for either platform.")
  endif()
endif()
string(TOLOWER "${PLATFORM}" PLATFORM)

if(PLATFORM STREQUAL "windows")
  set(MAKE_GENERATOR "MinGW Makefiles")
elseif(PLATFORM STREQUAL "linux")
  set(MAKE_GENERATOR "Unix Makefiles")
else()
  message(FATAL_ERROR "Invalid PLATFORM: ${PLATFORM}. Use windows or linux.")
endif()

set(template "${CMAKE_CURRENT_LIST_DIR}/CMakePresets.template.json")
if(NOT EXISTS "${template}")
  message(FATAL_ERROR "Template not found: ${template}. Keep both generator files in the same directory.")
endif()

# Replace only the platform token, preserving all CMake preset macros.
file(READ "${template}" content)
string(REPLACE "@MAKE_GENERATOR@" "${MAKE_GENERATOR}" content "${content}")
string(REPLACE "\r\n" "\n" content "${content}")
string(JSON document_type ERROR_VARIABLE json_error TYPE "${content}")
if(NOT json_error STREQUAL "NOTFOUND")
  message(FATAL_ERROR "Invalid JSON template: ${json_error}")
endif()
if(NOT document_type STREQUAL "OBJECT")
  message(FATAL_ERROR "The template must contain a JSON object.")
endif()

if(NOT DEFINED OUTPUT_DIR)
  set(OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}")
endif()
get_filename_component(OUTPUT_DIR "${OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
if(EXISTS "${OUTPUT_DIR}" AND NOT IS_DIRECTORY "${OUTPUT_DIR}")
  message(FATAL_ERROR "OUTPUT_DIR is not a directory: ${OUTPUT_DIR}")
endif()
set(output "${OUTPUT_DIR}/CMakePresets.json")
if(IS_DIRECTORY "${output}")
  message(FATAL_ERROR "Output path is a directory: ${output}")
endif()

if(EXISTS "${output}")
  if(NOT OVERWRITE)
    message(FATAL_ERROR "CMakePresets.json already exists. Edit it directly, or use -DOVERWRITE=ON to back it up and regenerate.")
  endif()
  string(TIMESTAMP stamp "%Y%m%d-%H%M%S")
  set(backup "${output}.bak-${stamp}")
  set(index 0)
  while(EXISTS "${backup}")
    math(EXPR index "${index} + 1")
    set(backup "${output}.bak-${stamp}-${index}")
  endwhile()
  file(COPY_FILE "${output}" "${backup}")
  message(STATUS "Backup: ${backup}")
endif()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(WRITE "${output}" "${content}")
message(STATUS "Generated: ${output}")
message(STATUS "Platform: ${PLATFORM}; generators: Ninja / ${MAKE_GENERATOR}")
message(STATUS "Edit the generated presets as needed, then run CMake Configure.")
